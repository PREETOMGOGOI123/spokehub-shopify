{%- comment -%}
  Renders a bike-spec SVG icon by name.
  Usage: {% render 'spec-icon', icon: spec.icon %}
  Known icons: wheel, fork, gears, brake, frame, shock
{%- endcomment -%}
{%- case icon -%}
  {%- when 'wheel' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3v6.5M12 14.5V21M3 12h6.5M14.5 12H21M5.6 5.6l4.6 4.6M13.8 13.8l4.6 4.6M18.4 5.6l-4.6 4.6M10.2 13.8l-4.6 4.6"/></svg>
  {%- when 'fork' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="M8.5 6h7"/><path d="M9 6l-1.2 7M15 6l1.2 7"/><path d="M7.8 13v3.5M16.2 13v3.5"/><circle cx="7.8" cy="19" r="2.5"/><circle cx="16.2" cy="19" r="2.5"/></svg>
  {%- when 'gears' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2"/></svg>
  {%- when 'brake' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="12" r="7.5"/><circle cx="10.5" cy="12" r="1.6"/><path d="M6.8 8.3l1.3 1.3M14.2 8.3l-1.3 1.3M6.8 15.7l1.3-1.3M14.2 15.7l-1.3-1.3"/><path d="M17 8.5h3.2a1 1 0 011 1v5a1 1 0 01-1 1H17a1 1 0 01-1-1v-5a1 1 0 011-1z"/></svg>
  {%- when 'frame' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17H4.5"/><path d="M10 17L12.5 7.5"/><path d="M4.5 17L12.5 7.5"/><path d="M12.5 7.5H18"/><path d="M10 17L17 11"/><path d="M18 7.5L17 11"/><path d="M12.5 7.5V5.5"/><path d="M11 5.5h3"/><path d="M18.5 6.2L17 7.5"/></svg>
  {%- when 'shock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19l3.5-3.5M15.5 8.5L19 5"/><rect x="7.6" y="8.9" width="8.8" height="6.2" rx="1" transform="rotate(-45 12 12)"/><path d="M9.2 12.5l1.6-1.6M11 14.3l1.6-1.6M12.8 16.1l1.6-1.6"/></svg>
{%- endcase -%}
