<div class="hcard">
  <a href="{{ product.url }}" class="hcard__img" aria-label="View {{ product.title }}">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 600 }}" width="600"
      height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
      alt="{{ product.title }}" loading="lazy">
    {% endif %}
    {% unless product.available %}
      <span class="hcard__badge">Sold out</span>
    {% endunless %}
  </a>

  <div class="hcard__body">
    <a href="{{ product.url }}" class="hcard__title-link">
      <h3 class="hcard__title">{{ product.title | downcase | capitalize }}</h3>
    </a>
    <div class="hcard__row">
      <p class="hcard__price">{{ product.price | money }}</p>
      <div class="hcard__actions">
        {% if product.available %}
          <form action="/cart/add" method="post" class="hcard__icon-form">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="hcard__icon-btn" aria-label="Add {{ product.title }} to cart">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </button>
          </form>
        {% endif %}
      </div>
    </div>
  </div>
</div>
