{%- capture star_svg_lg -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="var(--color-accent)" aria-hidden="true"><path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z"/></svg>{%- endcapture -%}
{%- capture star_svg_sm -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-accent)" aria-hidden="true"><path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z"/></svg>{%- endcapture -%}

<section id="reviews-{{ section.id }}" class="r-section reviews-section" data-key="{{ section.settings.google_api_key }}" data-place="{{ section.settings.place_id }}" data-read-text="{{ section.settings.read_text | escape }}" data-count="{{ section.settings.count }}">
  <h2 class="r-title reviews__title">{{ section.settings.heading }}</h2>

  <div class="reviews">
    <div class="reviews__summary">
      <div class="reviews__label">GOOGLE REVIEWS</div>
      <div class="reviews__score-row">
        <span class="reviews__score" data-score>{{ section.settings.score }}</span>
        <span class="reviews__of">/ 5</span>
      </div>
      <div class="reviews__stars" data-stars role="img" aria-label="Rated {{ section.settings.score }} out of 5">
        {{ star_svg_lg }}{{ star_svg_lg }}{{ star_svg_lg }}{{ star_svg_lg }}{{ star_svg_lg }}
      </div>
      <div>Based on <strong><span data-count-label>{{ section.settings.count }}</span> reviews</strong> {{ section.settings.summary_text }}</div>
      <div class="reviews__summary-buttons">
        {%- if section.settings.write_text != blank -%}
          {%- if section.settings.write_link != blank -%}
            {%- assign write_url = section.settings.write_link -%}
          {%- elsif section.settings.place_id != blank -%}
            {%- assign write_url = 'https://search.google.com/local/writereview?placeid=' | append: section.settings.place_id -%}
          {%- else -%}
            {%- assign write_url = '#' -%}
          {%- endif -%}
          <a href="{{ write_url }}" class="r-btn r-btn--accent" target="_blank" rel="noopener">{{ section.settings.write_text }}</a>
        {%- endif -%}
        {%- if section.settings.read_text != blank -%}
          {%- if section.settings.read_link != blank -%}
            {%- assign read_url = section.settings.read_link -%}
          {%- elsif section.settings.place_id != blank -%}
            {%- assign read_url = 'https://www.google.com/maps/place/?q=place_id:' | append: section.settings.place_id -%}
          {%- else -%}
            {%- assign read_url = '#' -%}
          {%- endif -%}
          <a href="{{ read_url }}" class="r-btn r-btn--outline-light" target="_blank" rel="noopener" data-read-link><span data-read-label>{{ section.settings.read_text | replace: '[count]', section.settings.count }}</span></a>
        {%- endif -%}
      </div>
    </div>

    <div class="reviews__main">
      <div class="reviews__track" id="reviews-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- assign initial = block.settings.name | strip | slice: 0, 1 | upcase -%}
          <article class="review" {{ block.shopify_attributes }}>
            <div class="review__who">
              <div class="review__avatar{% if forloop.index0 == 1 %} review__avatar--accent{% endif %}" aria-hidden="true">{{ initial }}</div>
              <div class="review__who-text">
                <div class="review__name">{{ block.settings.name }}</div>
                <div class="review__when">{{ block.settings.when }} · Google</div>
              </div>
            </div>
            <div class="review__stars" role="img" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..block.settings.stars) -%}{{ star_svg_sm }}{%- endfor -%}
            </div>
            <p class="review__text">{{ block.settings.text }}</p>
            <a href="{{ block.settings.link | default: section.settings.read_link | default: '#' }}" class="review__more" target="_blank" rel="noopener">Read more</a>
          </article>
        {%- endfor -%}
      </div>

      <div class="reviews__foot">
        <span class="reviews__note">{{ section.settings.note }}</span>
        <div class="reviews__arrows">
          <button type="button" class="reviews__arrow reviews__arrow--prev" aria-label="Previous reviews">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button type="button" class="reviews__arrow reviews__arrow--next" aria-label="Next reviews">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('reviews-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.reviews__track');

    function step(dir) {
      track.scrollBy({ left: dir * track.clientWidth * 0.9, behavior: 'smooth' });
    }
    root.querySelector('.reviews__arrow--prev').addEventListener('click', function () { step(-1); });
    root.querySelector('.reviews__arrow--next').addEventListener('click', function () { step(1); });

    // ---- live reviews from Google (Places API) -------------------------------------------
    // Runs only when an API key and a Place ID are set in the section settings. If anything
    // fails, the manual review blocks that are already on the page stay visible.
    var key = root.getAttribute('data-key');
    var placeId = root.getAttribute('data-place');
    if (!key || !placeId) return;

    var STAR = '<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-accent)" aria-hidden="true"><path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z"/></svg>';

    function el(tag, className, text) {
      var node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function card(r, i, fallbackUrl) {
      var name = (r.authorAttribution && r.authorAttribution.displayName) || 'Google user';
      var photo = r.authorAttribution && r.authorAttribution.photoURI;
      var text = typeof r.text === 'string' ? r.text : ((r.text && r.text.text) || (r.originalText && r.originalText.text) || '');
      var rating = Math.max(1, Math.min(5, Math.round(r.rating || 5)));
      var link = (r.authorAttribution && r.authorAttribution.uri) || fallbackUrl || '#';

      var article = el('article', 'review');

      var who = el('div', 'review__who');
      var avatar = el('div', 'review__avatar' + (i % 2 === 1 ? ' review__avatar--accent' : ''));
      avatar.setAttribute('aria-hidden', 'true');
      if (photo) {
        var img = document.createElement('img');
        img.src = photo;
        img.alt = '';
        img.referrerPolicy = 'no-referrer';
        avatar.appendChild(img);
      } else {
        avatar.textContent = name.charAt(0).toUpperCase();
      }
      var whoText = el('div', 'review__who-text');
      whoText.appendChild(el('div', 'review__name', name));
      whoText.appendChild(el('div', 'review__when', (r.relativePublishTimeDescription || '') + ' · Google'));
      who.appendChild(avatar);
      who.appendChild(whoText);

      var stars = el('div', 'review__stars');
      stars.setAttribute('role', 'img');
      stars.setAttribute('aria-label', rating + ' out of 5 stars');
      stars.innerHTML = new Array(rating + 1).join(STAR);

      var more = el('a', 'review__more', 'Read more');
      more.href = link;
      more.target = '_blank';
      more.rel = 'noopener';

      article.appendChild(who);
      article.appendChild(stars);
      article.appendChild(el('p', 'review__text', text));
      article.appendChild(more);
      return article;
    }

    function load(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    (async function () {
      try {
        if (!window.google || !google.maps) {
          await load('https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) + '&libraries=places&v=weekly');
        }
        var lib = await google.maps.importLibrary('places');
        var place = new lib.Place({ id: placeId });
        await place.fetchFields({ fields: ['reviews', 'rating', 'userRatingCount', 'googleMapsURI'] });

        // summary card
        if (place.rating) {
          root.querySelector('[data-score]').textContent = place.rating.toFixed(1);
          root.querySelector('[data-stars]').setAttribute('aria-label', 'Rated ' + place.rating.toFixed(1) + ' out of 5');
        }
        if (place.userRatingCount) {
          root.querySelector('[data-count-label]').textContent = place.userRatingCount;
          var label = root.querySelector('[data-read-label]');
          if (label) label.textContent = (root.getAttribute('data-read-text') || 'Read all [count] on Google').replace('[count]', place.userRatingCount);
        }
        var readLink = root.querySelector('[data-read-link]');
        if (readLink && place.googleMapsURI) readLink.href = place.googleMapsURI;

        // review cards
        if (place.reviews && place.reviews.length) {
          var frag = document.createDocumentFragment();
          place.reviews.forEach(function (r, i) { frag.appendChild(card(r, i, place.googleMapsURI)); });
          track.replaceChildren(frag);
        }
      } catch (e) {
        console.error('Google reviews failed to load — showing the manual reviews instead.', e);
      }
    })();
  })();
</script>

{% stylesheet %}
  .reviews__title {
    margin-bottom: 2.4rem;
  }

  .reviews {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.6rem;
  }

  .reviews__summary {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 2.8rem;
    border-radius: 10px;
    background: var(--color-ink);
    color: #fff;
  }

  .reviews__label {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #bdbdbd;
  }

  .reviews__score-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .reviews__score {
    font-family: var(--font-family-heading);
    font-weight: 800;
    font-size: 9.6rem;
    line-height: 0.85;
  }

  .reviews__of {
    font-size: 1.8rem;
    color: #bdbdbd;
  }

  .reviews__stars {
    display: flex;
    gap: 3px;
  }

  .reviews__summary-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.8rem;
  }

  .reviews__main {
    flex: 3 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, calc((100% - 2.4rem) / 3));
    gap: 1.2rem;
    flex: 1;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.2rem;
    scroll-snap-align: start;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
  }

  .review__who {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .review__avatar {
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-ink);
    color: #fff;
    font-weight: 700;
  }

  .review__avatar--accent {
    background: var(--color-accent);
  }

  .review__avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .review__who-text {
    flex: 1;
    min-width: 0;
  }

  .review__name {
    font-weight: 700;
  }

  .review__when {
    font-size: 1.3rem;
    color: #5c5c5c;
  }

  .review__stars {
    display: flex;
    gap: 2px;
  }

  .review__text {
    margin: 0;
    color: #3d3d3d;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: 6.4em;
  }

  .review__more {
    margin-top: auto;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .reviews__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .reviews__note {
    font-size: 1.3rem;
    color: #5c5c5c;
  }

  .reviews__arrows {
    display: flex;
    gap: 0.8rem;
  }

  .reviews__arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid #c4c4c4;
    border-radius: 50%;
    background: var(--color-surface);
    cursor: pointer;
  }

  .reviews__arrow--next {
    border: 0;
    background: var(--color-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What riders say on Google" },
    { "type": "text", "id": "score", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "count", "label": "Number of reviews", "default": "322" },
    { "type": "text", "id": "summary_text", "label": "Text after the count", "default": "from riders in Guwahati and across the Northeast" },
    { "type": "text", "id": "write_text", "label": "Write-a-review button text", "default": "Write a review" },
    { "type": "url", "id": "write_link", "label": "Write-a-review link", "info": "Your Google review link." },
    { "type": "text", "id": "read_text", "label": "Read-all button text", "info": "[count] is replaced by the number of Google reviews.", "default": "Read all [count] on Google" },
    { "type": "url", "id": "read_link", "label": "Read-all link", "info": "Your Google Maps / Business Profile link." },
    { "type": "text", "id": "note", "label": "Small note", "default": "Reviews shown live from Google Business Profile" },
    { "type": "header", "content": "Live Google reviews" },
    { "type": "text", "id": "google_api_key", "label": "Google API key", "info": "Needs the Maps JavaScript API and Places API (New) enabled. Restrict the key to your website addresses in Google Cloud. Leave empty to show the manual reviews below." },
    { "type": "text", "id": "place_id", "label": "Google Place ID" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Reviewer name", "default": "[Reviewer name]" },
        { "type": "text", "id": "when", "label": "When", "default": "[2 weeks ago]" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "[Paste a real Google review]" },
        { "type": "url", "id": "link", "label": "Link to the review" }
      ]
    }
  ],
  "presets": [
    { "name": "Reviews" }
  ]
}
{% endschema %}
