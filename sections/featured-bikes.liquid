<section class="featured-bikes reveal">
  <div class="products__head">
    <h2 class="products__title">{{ section.settings.heading }}</h2>
    <a href="/collections/bikes" class="products__viewall">View all →</a>
  </div>

  <div class="featured-slider-bikes">
    <button class="slider-arrow slider-arrow--left" aria-label="Scroll left" data-dir="-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <div class="featured-track-bikes" id="featured-track-bikes">
      {% assign cats = 'bikes' | split: ', ' %}
      {% for handle in cats %}
        {% assign col = collections[handle] %}
        {% assign shown = 0 %}
        {% for product in col.products %}
          {% if product.available %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
            {% if shown >= 6 %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>

    <button class="slider-arrow slider-arrow--right" aria-label="Scroll right" data-dir="1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</section>

<script>
  (function () {
    var slider = document.querySelector('.featured-slider-bikes');
    if (!slider) return;
    var track = slider.querySelector('.featured-track-bikes');
    slider.querySelectorAll('.slider-arrow').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dir = parseInt(btn.getAttribute('data-dir'), 10);
        track.scrollBy({ left: dir * track.clientWidth * 0.7, behavior: 'smooth' });
      });
    });
  })();
</script>

{% stylesheet %}
  .featured-bikes {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-8) var(--page-padding) var(--section-y);
  }

  .featured-slider-bikes {
    position: relative;
    display: flex;
    align-items: center;
  }

  .featured-track-bikes {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }

  .featured-track-bikes::-webkit-scrollbar {
    display: none;
  }

  .featured-track-bikes .card {
    flex: 0 0 auto;
    width: 240px;
    scroll-snap-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Bikes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Bikes" }
  ],
  "presets": [
    { "name": "Featured Bikes" }
  ]
}
{% endschema %}
