<div class="contact-bar">
  <div class="contact-bar__inner">
    <div class="contact-bar__info">
      {% if section.settings.phone != blank %}
        <a href="https://wa.me/{{ section.settings.phone | remove: '+' | remove: ' ' }}" class="contact-bar__link contact-bar__link--icon" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          {{ section.settings.phone }}
        </a>
      {% endif %}
      {% if section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email }}" class="contact-bar__link contact-bar__link--icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m2 6 10 7 10-7"/>
          </svg>
          {{ section.settings.email }}
        </a>
      {% endif %}
    </div>

    <div class="contact-bar__actions">
      <a href="/account" class="contact-bar__link contact-bar__link--icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/>
        </svg>
        Account
      </a>

      <a href="/cart" class="contact-bar__link contact-bar__link--icon contact-bar__cart">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6h15l-1.5 9h-12z"/>
          <circle cx="9" cy="20" r="1.5"/>
          <circle cx="18" cy="20" r="1.5"/>
          <path d="M6 6 5 3H2"/>
        </svg>
        Cart
        <span class="contact-bar__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</div>

<div class="header-wrap">
<header class="header">
  <input type="checkbox" id="nav-toggle" class="header__toggle-input" hidden>
  <label for="nav-toggle" class="header__hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </label>

  <a href="/" class="header__logo">
    <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name }}" width="1743" height="452">
  </a>

  <form action="{{ routes.search_url }}" method="get" class="header__search" role="search">
    <svg class="header__search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="m21 21-4.3-4.3"/>
    </svg>
    <input type="search" name="q" placeholder="Search bikes, helmets, spares…" class="header__search-input" aria-label="Search">
  </form>

  {%- comment -%} inline menu on desktop; slide-out menu on tablet/mobile {%- endcomment -%}
  <nav class="header__nav">
    <a href="/" class="header__nav-link">Home</a>
    <a href="/collections/all" class="header__nav-link">Collections</a>
    <a href="/pages/service" class="header__nav-link">Service</a>
    <a href="/pages/events" class="header__nav-link">Events</a>
    <a href="/pages/about" class="header__nav-link">About Us</a>
    <a href="/pages/contact" class="header__nav-link">Contact</a>
  </nav>

  {%- comment -%} cart icon for tablet/mobile; on desktop the cart lives in the top bar {%- endcomment -%}
  <div class="header__actions">
    <a href="/cart" class="header__icon" aria-label="Cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6h15l-1.5 9h-12z"/>
        <circle cx="9" cy="20" r="1.5"/>
        <circle cx="18" cy="20" r="1.5"/>
        <path d="M6 6 5 3H2"/>
      </svg>
      <span class="header__cart-count">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% if section.settings.announcement != blank %}
  <div class="announcement">
    <span>{{ section.settings.announcement }}</span>
  </div>
{% endif %}
</div>

{% stylesheet %}
.header-wrap {
    position: relative;
    z-index: 100;
}

/* desktop: logo | search | menu — all on one line */
.header {
    position: relative;
    top: auto;
    left: 0;
    right: 0;
    z-index: 100;
    box-sizing: border-box;
    background: #fff;
    color: var(--gray-12);
    padding: var(--space-5) var(--page-padding);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-6);
    max-width: none;
    margin: 0 auto;
    border: 1px solid var(--gray-5);
    border-radius: var(--radius-3);
    box-shadow: none;
    transition: padding 0.2s ease, background 0.08s ease;
}

.header--scrolled {
    position: fixed;
    top: 0;
    padding: var(--space-3) var(--page-padding);
}

.header__logo {
    display: inline-flex;
    justify-self: start;
    text-decoration: none;
}

.header__logo img {
    display: block;
    height: 56px;
    width: auto;
    transition: height 0.2s ease;
}

.header--scrolled .header__logo img {
    height: 42px;
}

/* Search */
.header__search {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 56rem;
    margin: 0;
}

.header__search-icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray-10);
    pointer-events: none;
}

.header__search-input {
    width: 100%;
    height: 4.8rem;
    box-sizing: border-box;
    padding: 0 var(--space-4) 0 4.6rem;
    font-size: var(--font-size-3);
    color: var(--color-text);
    background: var(--gray-2);
    border: 1px solid var(--gray-6);
    border-radius: 0.6rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.header__search-input::placeholder {
    color: var(--gray-9);
}

.header__search-input:hover {
    border-color: var(--gray-8);
}

.header__search-input:focus {
    border-color: var(--color-accent);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(240, 0, 9, 0.12);
}

.header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
}

/* header cart: tablet/mobile only (desktop cart is in the top bar) */
.header__actions {
    display: none;
}

.header__nav-link {
    position: relative;
    padding: var(--space-2) 0;
    color: var(--gray-12);
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
}

/* red underline that grows from the left on hover */
.header__nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
}

.header__nav-link:hover {
    color: var(--color-accent);
}

.header__nav-link:hover::after {
    transform: scaleX(1);
}

.header__actions {
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
}

.header__icon {
    color: var(--gray-12);
    display: inline-flex;
    position: relative;
}

.header__icon:hover {
    color: var(--color-accent);
}

.header__cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-accent);
    color: #fff;
    font-size: 11px;
    font-weight: var(--font-weight-bold);
    min-width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
}

/* Announcement bar */
.announcement {
    /* soft red tint — ties to the brand red without shouting */
    background: var(--red-3);
    color: var(--red-11);
    text-align: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-medium);
    border-bottom: 1px solid var(--red-5);
}

/* Top bar: contact on the left, account + cart on the right */
.contact-bar {
    position: relative;
    padding: calc(var(--space-2) + 2px) 0;
    background: #fff;
    border-bottom: 1px solid var(--gray-5);
}

.contact-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    box-sizing: border-box;
    padding: 0 var(--page-padding);
}

.contact-bar__info,
.contact-bar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
}

.contact-bar__link {
    color: var(--gray-11);
    font-size: var(--font-size-2);
    text-decoration: none;
}

.contact-bar__link:hover {
    color: var(--color-accent);
}

.contact-bar__link--icon {
    display: flex;
    align-items: center;
    gap: var(--space-1);
}

.contact-bar__link--icon svg {
    display: block;
    flex-shrink: 0;
}

.contact-bar__cart {
    color: var(--gray-12);
    font-weight: var(--font-weight-medium);
}

.contact-bar__cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 11px;
    font-weight: var(--font-weight-bold);
}

/* Hamburger — hidden on desktop */
.header__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: var(--space-2);
}

.header__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--gray-12);
    border-radius: 2px;
}

/* tablet + mobile: hamburger | logo | cart, search on its own row below */
@media (max-width: 900px) {
    .contact-bar {
        display: none;
    }

    .header {
        grid-template-columns: auto 1fr auto;
        column-gap: var(--space-3);
        row-gap: var(--space-4);
    }

    .header__hamburger {
        display: flex;
    }

    .header__logo {
        justify-self: center;
    }

    .header__search {
        grid-column: 1 / -1;
        grid-row: 2;
        max-width: none;
    }

    .header__actions {
        display: flex;
    }

    .header__nav {
        display: flex;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 75%;
        max-width: 320px;
        background: #fff;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
        padding: var(--space-8) var(--space-5);
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        box-shadow: var(--shadow-4);
        z-index: 200;
    }

    .header__toggle-input:checked~.header__nav {
        transform: translateX(0);
    }

    .header__nav-link {
        padding: var(--space-4) 0;
        font-size: var(--font-size-4);
        width: 100%;
        border-bottom: 1px solid var(--color-border);
    }

    .header__nav-link::after {
        content: none;
    }
}

@media (max-width: 640px) {
    .announcement {
        font-size: var(--font-size-1);
    }

    .header__search-input {
        height: 4.4rem;
    }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement / Flash sale text", "default": "🔥 Flash Sale — 20% OFF all cycling shoes. Limited time!" },
    { "type": "text", "id": "phone", "label": "Contact phone", "default": "+91 70990 32144" },
    { "type": "text", "id": "email", "label": "Contact email", "default": "support@spokehub.com" }
  ]
}
{% endschema %}
