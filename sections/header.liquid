{%- comment -%}
  Redesign header: black announcement bar on top, white header below.
  Menu links come from the store's navigation (Online Store → Navigation); if the menu
  is empty, the design's default links are shown instead.
{%- endcomment -%}

{% if section.settings.announcement_text != blank %}
  <div class="announcement">
    <div class="announcement__inner">
      <div class="announcement__main">
        {% if section.settings.announcement_badge != blank %}
          <span class="announcement__badge">{{ section.settings.announcement_badge }}</span>
        {% endif %}
        <span>{{ section.settings.announcement_text }}</span>
        {% if section.settings.announcement_link_text != blank %}
          <a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}" class="announcement__link">{{ section.settings.announcement_link_text }}</a>
        {% endif %}
      </div>
      <div class="announcement__side">
        {% if section.settings.phone != blank %}
          <a href="https://wa.me/{{ section.settings.phone | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">WhatsApp {{ section.settings.phone }}</a>
        {% endif %}
        {% if section.settings.perk != blank %}
          <span>{{ section.settings.perk }}</span>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

<header class="header">
  <div class="header__inner">
    <input type="checkbox" id="nav-toggle" class="header__toggle-input" hidden>
    <label for="nav-toggle" class="header__hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager', class: 'header__logo-img' }}
      {%- else -%}
        <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name }}" width="1743" height="452" class="header__logo-img">
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="Main">
      {%- assign main_menu = linklists[section.settings.menu] -%}
      {%- if main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          {%- assign link_title = link.title | downcase -%}
          <a href="{{ link.url }}" class="header__nav-link{% if link_title == 'sale' %} header__nav-link--sale{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.collections_url }}/bikes" class="header__nav-link">Bikes</a>
        <a href="{{ routes.collections_url }}/mtb-spares" class="header__nav-link">Parts &amp; Spares</a>
        <a href="{{ routes.collections_url }}/apparels" class="header__nav-link">Apparel</a>
        <a href="{{ routes.collections_url }}/helmets" class="header__nav-link">Helmets</a>
        <a href="{{ routes.collections_url }}/road-bikes" class="header__nav-link">Shoes</a>
        <a href="{{ routes.collections_url }}/accessories" class="header__nav-link">Accessories</a>
        <a href="{{ routes.collections_url }}/sale" class="header__nav-link header__nav-link--sale">Sale</a>
      {%- endif -%}
    </nav>

    <div class="header__actions">
      <form action="{{ routes.search_url }}" method="get" class="header__search" role="search">
        <label for="header-search" class="visually-hidden">Search products</label>
        <input id="header-search" type="search" name="q" placeholder="Search bikes, parts, brands" class="header__search-input">
      </form>

      <a href="{{ routes.account_url }}" class="header__icon" aria-label="Account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="header__icon" aria-label="Cart, {{ cart.item_count }} items">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
        <span class="header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- announcement bar ---------- */
  .announcement {
    background: var(--color-ink);
    color: #fff;
    font-size: var(--font-size-2);
  }

  .announcement__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 1rem var(--page-padding);
  }

  .announcement__main,
  .announcement__side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .announcement__side {
    gap: var(--space-2) 2rem;
    color: #ccc;
  }

  .announcement a {
    color: #fff;
    text-decoration: none;
  }

  .announcement a.announcement__link {
    text-decoration: underline;
  }

  .announcement__side a {
    color: #ccc;
  }

  .announcement__link {
    text-decoration: underline;
  }

  .announcement a:hover {
    text-decoration: underline;
  }

  .announcement__badge {
    background: var(--color-accent);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.8rem;
    border-radius: 3px;
  }

  .announcement__link {
    font-weight: 600;
  }

  /* ---------- header ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem 3.2rem;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 1.4rem var(--page-padding);
  }

  .header__logo {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    gap: 0.8rem;
    text-decoration: none;
  }


  .header__logo-img {
    display: block;
    height: 4rem;
    width: auto;
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.4rem;
  }

  .header__nav-link {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 500;
    text-decoration: none;
  }

  .header__nav-link:hover {
    color: var(--color-accent);
  }

  .header__nav-link--sale {
    color: var(--color-accent);
    font-weight: 600;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header__search {
    margin: 0;
  }

  .header__search-input {
    width: 22rem;
    max-width: 100%;
    height: 4.4rem;
    box-sizing: border-box;
    padding: 0 1.4rem;
    font: inherit;
    font-size: var(--font-size-2);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid #c4c4c4;
    border-radius: 6px;
    outline: none;
  }

  .header__search-input:focus {
    border-color: var(--color-accent);
    background: var(--color-surface);
  }

  .header__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 6px;
    color: var(--color-text);
  }

  .header__icon:hover {
    color: var(--color-accent);
  }

  .header__cart-count {
    position: absolute;
    top: 0.4rem;
    right: 0.2rem;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 0.4rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 0.9rem;
  }

  /* hamburger — tablet / mobile only */
  .header__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    cursor: pointer;
  }

  .header__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
  }

  /* tablet + mobile: hamburger | logo | search + icons, menu slides out */
  @media (max-width: 1000px) {
    .header__hamburger {
      display: flex;
    }

    .header__inner {
      gap: var(--space-3);
    }

    .header__nav {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 200;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      width: 80%;
      max-width: 32rem;
      height: 100vh;
      padding: var(--space-8) var(--space-5);
      box-sizing: border-box;
      background: var(--color-surface);
      box-shadow: var(--shadow-4);
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }

    .header__toggle-input:checked ~ .header__nav {
      transform: translateX(0);
    }

    .header__nav-link {
      width: 100%;
      padding: var(--space-4) 0;
      font-size: var(--font-size-4);
      border-bottom: 1px solid var(--color-border);
    }

    .header__search-input {
      width: 16rem;
    }
  }

  @media (max-width: 640px) {
    .announcement__side {
      display: none;
    }

    .header__search {
      display: none;
    }

    .header__logo-img {
      height: 3.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Announcement bar" },
    { "type": "text", "id": "announcement_badge", "label": "Badge", "default": "FLASH SALE" },
    { "type": "text", "id": "announcement_text", "label": "Text", "default": "20% off all cycling shoes — limited time." },
    { "type": "text", "id": "announcement_link_text", "label": "Link text", "default": "Shop shoes" },
    { "type": "url", "id": "announcement_link", "label": "Link" },
    { "type": "text", "id": "phone", "label": "WhatsApp number", "default": "+91 70990 32144" },
    { "type": "text", "id": "perk", "label": "Perk text", "default": "Free delivery over ₹[AMOUNT]" },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use the spokehub logo in the theme assets." },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty to use the design's menu: Bikes, Parts & Spares, Apparel, Helmets, Shoes, Accessories, Sale." }
  ]
}
{% endschema %}
