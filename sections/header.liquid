{% if section.settings.announcement != blank %}
  <div class="announcement">
    <span>{{ section.settings.announcement }}</span>
  </div>
{% endif %}

<div class="contact-bar">
  <div class="contact-bar__inner">
    <div class="contact-bar__info">
      {% if section.settings.phone != blank %}
        <a href="https://wa.me/{{ section.settings.phone | remove: '+' | remove: ' ' }}" class="contact-bar__link contact-bar__link--icon" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          {{ section.settings.phone }}
        </a>
      {% endif %}
      {% if section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email }}" class="contact-bar__link contact-bar__link--icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m2 6 10 7 10-7"/>
          </svg>
          {{ section.settings.email }}
        </a>
      {% endif %}
    </div>

    <div class="contact-bar__actions">
      <form action="/search" method="get" class="contact-bar__search" role="search">
        <svg class="contact-bar__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="search" name="q" placeholder="Search" class="contact-bar__search-input">
      </form>

      <a href="/account" class="contact-bar__link contact-bar__link--icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/>
        </svg>
        Account
      </a>
    </div>
  </div>
</div>

<header class="header">
  <input type="checkbox" id="nav-toggle" class="header__toggle-input" hidden>
  <label for="nav-toggle" class="header__hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </label>

  <a href="/" class="header__logo">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="7000" height="3000">
  </a>

  <nav class="header__nav">
    <a href="/" class="header__nav-link">Home</a>
    <a href="/collections/all" class="header__nav-link">Collections</a>
    <a href="/pages/service" class="header__nav-link">Service</a>
    <a href="/pages/about" class="header__nav-link">About Us</a>
    <a href="/pages/contact" class="header__nav-link">Contact</a>
  </nav>

  <div class="header__actions">
    <a href="/cart" class="header__icon" aria-label="Cart">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6h15l-1.5 9h-12z"/>
        <circle cx="9" cy="20" r="1.5"/>
        <circle cx="18" cy="20" r="1.5"/>
        <path d="M6 6 5 3H2"/>
      </svg>
      <span class="header__cart-count">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% stylesheet %}
.header {
    position: absolute;
    top: 115px;
    left: 0;
    right: 0;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.82);
    color: #fff;
    padding: var(--space-3) var(--page-padding);
    display: flex;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    border-radius: var(--radius-3);
    box-shadow: none;
    transition: padding 0.2s ease, background 0.08s ease;
}

.header--scrolled {
    position: fixed;
    top: 0;
    padding: var(--space-3) var(--page-padding);
}

.header__logo {
    display: inline-flex;
    text-decoration: none;
}

.header__logo img {
    display: block;
    height: 56px;
    width: auto;
    transition: height 0.2s ease;
}

.header--scrolled .header__logo img {
    height: 42px;
}

.header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.header__nav-link {
    position: relative;
    color: var(--gray-6);
    text-decoration: none;
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: color 0.08s ease;
}

.header__nav-link+.header__nav-link::before {
    content: "|";
    position: absolute;
    left: calc(var(--space-8) / -2);
    transform: translateX(-50%);
    color: var(--gray-11);
}

.header__nav-link:hover {
    color: var(--color-accent);
}

.header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-5);
}

.header__icon {
    color: #fff;
    display: inline-flex;
    position: relative;
}

.header__icon:hover {
    color: var(--color-accent);
}

.header__cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--color-accent);
    color: #fff;
    font-size: 11px;
    font-weight: var(--font-weight-bold);
    min-width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
}

/* Announcement bar */
.announcement {
    background: #111111;
    color: #fff;
    text-align: center;
    padding: var(--space-4) var(--space-4);
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-medium);
    border-bottom: 1px solid var(--gray-11);
}

/* Contact bar */
.contact-bar {
    position: relative;
    padding: calc(var(--space-2) + 2px) 0;
    background: #333333;
    border-bottom: 1px solid var(--gray-11);
}

.contact-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 1100px;
    max-width: 100%;
    margin: 0 auto;
}

.contact-bar__info,
.contact-bar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
}

.contact-bar__link {
    color: var(--gray-6);
    font-size: var(--font-size-2);
    text-decoration: none;
}

.contact-bar__link:hover {
    color: #fff;
}

.contact-bar__link--icon {
    display: flex;
    align-items: center;
    gap: var(--space-1);
}

.contact-bar__link--icon svg {
    display: block;
    flex-shrink: 0;
}

.contact-bar__search {
    position: relative;
    display: flex;
    align-items: center;
    width: 160px;
}

.contact-bar__search-icon {
    position: absolute;
    right: calc(160px - var(--space-6));
    color: var(--gray-11);
    pointer-events: none;
    z-index: 1;
    transition: right 0.25s ease;
}

.contact-bar__search:has(.contact-bar__search-input:hover) .contact-bar__search-icon,
.contact-bar__search:has(.contact-bar__search-input:focus) .contact-bar__search-icon {
    right: calc(210px - var(--space-6));
}

.contact-bar__search-input {
    position: absolute;
    right: 0;
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-6);
    font-size: var(--font-size-2);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    outline: none;
    background: #fff;
    color: var(--color-text);
    width: 160px;
    box-sizing: border-box;
    transition: background 0.2s ease, border-color 0.2s ease, width 0.25s ease;
}

.contact-bar__search-input:hover {
    border-color: var(--color-accent);
    width: 210px;
}

.contact-bar__search-input::placeholder {
    color: var(--gray-9);
}

.contact-bar__search-input:focus {
    border-color: var(--color-accent);
    background: var(--gray-5);
    width: 210px;
}

/* Hamburger — hidden on desktop */
.header__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: var(--space-2);
}

.header__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
}

@media (max-width: 640px) {
    .header__hamburger {
        display: flex;
    }

    .header__nav {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 75%;
        max-width: 320px;
        background: #fff;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
        padding: var(--space-8) var(--space-5);
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        box-shadow: var(--shadow-4);
        z-index: 200;
    }

    .header__toggle-input:checked~.header__nav {
        transform: translateX(0);
    }

    .header__nav-link+.header__nav-link::before {
        content: none;
    }

    .header__nav-link {
        padding: var(--space-4) 0;
        font-size: var(--font-size-4);
        width: 100%;
        border-bottom: 1px solid var(--color-border);
    }

    .header {
        justify-content: space-between;
    }

    .header__logo img {
        height: 32px;
    }

    .header__actions {
        gap: var(--space-4);
    }

    .announcement {
        font-size: var(--font-size-1);
    }

    .contact-bar__inner {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
    }

    .contact-bar__info,
    .contact-bar__actions {
        width: 100%;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .contact-bar__actions {
        justify-content: space-between;
    }

    .contact-bar__search,
    .contact-bar__search-input {
        width: 130px;
    }

    .contact-bar__search-icon {
        right: calc(130px - var(--space-6));
    }

    .contact-bar__search-input:hover,
    .contact-bar__search-input:focus {
        width: 130px;
    }

    .contact-bar__search:has(.contact-bar__search-input:hover) .contact-bar__search-icon,
    .contact-bar__search:has(.contact-bar__search-input:focus) .contact-bar__search-icon {
        right: calc(130px - var(--space-6));
    }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "announcement", "label": "Announcement / Flash sale text", "default": "🔥 Flash Sale — 20% OFF all cycling shoes. Limited time!" },
    { "type": "text", "id": "phone", "label": "Contact phone", "default": "+91 70990 32144" },
    { "type": "text", "id": "email", "label": "Contact email", "default": "support@spokehub.com" }
  ]
}
{% endschema %}
