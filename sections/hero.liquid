<section class="hero">
  <div class="hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <div class="hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    <h1 class="hero__title">{{ section.settings.heading }}</h1>

    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hero__buttons">
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero__btn hero__btn--primary">{{ section.settings.button_text }}</a>
      {%- endif -%}
      {%- if section.settings.button2_text != blank -%}
        <a href="{{ section.settings.button2_link | default: routes.root_url }}" class="hero__btn hero__btn--secondary">{{ section.settings.button2_text }}</a>
      {%- endif -%}
    </div>

    <div class="hero__checks">
      {%- if section.settings.check_1 != blank -%}
        <span class="hero__check">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
          {{ section.settings.check_1 }}
        </span>
      {%- endif -%}
      {%- if section.settings.check_2 != blank -%}
        <span class="hero__check">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
          {{ section.settings.check_2 }}
        </span>
      {%- endif -%}
    </div>
  </div>

  <div class="hero__media{% if section.settings.image != blank %} hero__media--image{% endif %}">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag:
        class: 'hero__img',
        alt: section.settings.image.alt,
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '(min-width: 1280px) 620px, 100vw',
        widths: '600, 900, 1200, 1600'
      }}
    {%- else -%}
      <div class="hero__placeholder-label">HERO PHOTO</div>
      <div class="hero__placeholder-text">Real rider on a local trail or ghat road — one strong image, no carousel</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 4rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(3.2rem, 6vw, 7.2rem) clamp(1.6rem, 4vw, 4rem);
  }

  .hero__copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.4rem;
  }

  .hero__eyebrow {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 800;
    font-size: clamp(4.8rem, 7vw, 9.2rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .hero__text {
    margin: 0;
    max-width: 52rem;
    font-size: 1.8rem;
    color: #3d3d3d;
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    height: 5.2rem;
    box-sizing: border-box;
    border-radius: 6px;
    font-weight: 700;
    text-decoration: none;
  }

  .hero__btn--primary {
    padding: 0 2.8rem;
    background: var(--color-accent);
    color: #fff;
  }

  .hero__btn--primary:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }

  .hero__btn--secondary {
    padding: 0 2.6rem;
    border: 2px solid var(--color-ink);
    color: var(--color-ink);
  }

  .hero__btn--secondary:hover {
    background: var(--color-ink);
    color: #fff;
  }

  .hero__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    font-size: 1.4rem;
    color: #3d3d3d;
  }

  .hero__check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__media {
    position: relative;
    flex: 1 1 460px;
    min-width: 0;
    min-height: 440px;
    box-sizing: border-box;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #e6e6e6;
    border-radius: 10px;
    color: #4d4d4d;
  }

  .hero__media--image {
    padding: 0;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder-label {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero__placeholder-text {
    font-size: 1.4rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "One strong image — a real rider on a local trail or ghat road. Around 1600 × 1200 px." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GUWAHATI · SINCE 2017" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your next bike, delivered ready to ride" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Bikes, parts and a proper workshop under one roof. Shop online, book a service, or join the next group ride." },
    { "type": "text", "id": "button_text", "label": "Primary button text", "default": "Shop bikes" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_text", "label": "Secondary button text", "default": "Book a service" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "text", "id": "check_1", "label": "Tick line 1", "default": "Authorised Shimano dealer" },
    { "type": "text", "id": "check_2", "label": "Tick line 2", "default": "Polygon · Marin · Wahoo" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
