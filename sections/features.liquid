<section class="features reveal">
  <div class="features__inner">
    <div class="features__item">
      <svg class="features__icon" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42zM6 7.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0z"/>
      </svg>
      <h3 class="features__title">Best Price Promise</h3>
      <p class="features__text">Found it cheaper? We'll match it.</p>
    </div>

    <div class="features__item">
      <svg class="features__icon" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>
        <path d="M7 10v12" fill="none" stroke="#fff" stroke-width="1.5"/>
      </svg>
      <h3 class="features__title">Easy Returns</h3>
      <p class="features__text">Ride with peace of mind.</p>
    </div>

    <div class="features__item">
      <svg class="features__icon" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/>
        <circle cx="12" cy="8" r="6"/>
      </svg>
      <h3 class="features__title">Expert Assembly</h3>
      <p class="features__text">Built by our workshop, ready to ride.</p>
    </div>
  </div>
</section>

{% stylesheet %}
  /* full-width light grey strip behind the icon row */
  .features {
    background: var(--gray-3);
  }

  .features__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-9) var(--page-padding);
    text-align: center;
  }

  .features__icon {
    width: 4.8rem;
    height: 4.8rem;
    color: var(--gray-12);
  }

  .features__title {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--font-size-5);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .features__text {
    margin: 0;
    font-size: var(--font-size-3);
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .features__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      padding-block: var(--space-8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Features",
  "presets": [
    { "name": "Features" }
  ]
}
{% endschema %}
