<section class="featured reveal">
  <div class="featured__head">
    <h2 class="featured__title">{{ section.settings.heading }}</h2>
    <p class="featured__subtitle">{{ section.settings.subheading }}</p>
  </div>

  <div class="featured-slider">
      <div class="featured-track" id="featured-track">
        {% assign cats = 'mtb-spares, helmets, bike-chain, road-bikes' | split: ', ' %}
        {% for handle in cats %}
          {% assign col = collections[handle] %}
          {% assign shown = 0 %}
          {% for product in col.products %}
            {% if product.available %}
              {% render 'product-card-horizontal', product: product %}
              {% assign shown = shown | plus: 1 %}
              {% if shown >= 3 %}{% break %}{% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>

    <button type="button" class="featured__arrow featured__arrow--prev" aria-label="Scroll left" data-dir="-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
    </button>

    <button type="button" class="featured__arrow featured__arrow--next" aria-label="Scroll right" data-dir="1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
    </button>
  </div>
</section>

<script>
  (function () {
    var slider = document.querySelector('.featured-slider');
    if (!slider) return;
    var track = slider.querySelector('.featured-track');
    slider.querySelectorAll('.featured__arrow').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dir = parseInt(btn.getAttribute('data-dir'), 10);
        track.scrollBy({ left: dir * track.clientWidth * 0.7, behavior: 'smooth' });
      });
    });
  })();
</script>

{% stylesheet %}
  .featured {
    padding-block: calc(var(--space-8) * 2.5);
  }

  /* heading block — same style as the Shop by Category section */
  .featured__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: var(--page-max);
    margin: 0 auto calc(var(--space-8) * 1.5);
    padding-inline: var(--page-padding);
    text-align: center;
  }

  .featured__title {
    font-size: var(--font-size-8);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .featured__subtitle {
    color: var(--color-muted);
    font-size: var(--font-size-3);
    max-width: 480px;
    margin: 0;
  }

  .featured-slider {
    position: relative;
  }

  .featured__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--gray-12);
    box-shadow: var(--shadow-3);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .featured__arrow:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .featured__arrow--prev {
    left: var(--space-4);
  }

  .featured__arrow--next {
    right: var(--space-4);
  }

  /* full-width row; side padding lines the first card up with the page content */
  .featured-track {
    --track-pad: max(var(--page-padding), calc((100vw - var(--page-max)) / 2));
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    padding-inline: var(--track-pad);
    padding-bottom: var(--space-2);
    scroll-padding-inline: var(--track-pad);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .featured-track::-webkit-scrollbar {
    display: none;
  }

  .featured-track .hcard {
    flex: 0 0 auto;
    width: 360px;
    scroll-snap-align: start;
  }

  .hcard {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--gray-4, #e4e4e4);
    background: #fff;
    overflow: hidden;
  }

  .hcard__img {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--gray-3);
    overflow: hidden;
  }

  .hcard__img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.06);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* hover — same as the category cards: image zooms, title turns red */
  .hcard:hover .hcard__img img {
    transform: scale(1.05);
  }

  .hcard__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }


  .hcard__scrim {
    display: none;
  }

  .hcard__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 2;
    background: var(--gray-12);
    color: #fff;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-medium);
    padding: var(--space-1) var(--space-2);
  }

  .hcard__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hcard__title-link {
    text-decoration: none;
    color: inherit;
  }

  .hcard:hover .hcard__title,
  .hcard:hover .hcard__price {
    color: var(--color-accent);
  }

  .hcard__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .hcard__actions {
    display: flex;
    gap: var(--space-2);
  }

  .hcard__icon-form {
    margin: 0;
  }

  .hcard__icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #fff;
    border: 1px solid var(--gray-12);
    color: var(--gray-12);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .hcard__icon-btn:hover {
    border-color: var(--gray-6, #c4c4c4);
  }

  .hcard__icon-btn svg {
    position: relative;
    z-index: 1;
    transition: transform 0.2s ease;
  }

  .hcard__icon-btn:hover svg {
    transform: scale(1.15);
  }

  .hcard__title {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    height: 2.6em;
    color: var(--color-muted);
    transition: color 0.2s ease;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hcard__price {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-bold);
    color: var(--gray-12);
    transition: color 0.2s ease;
    margin: 0;
  }

  @media (max-width: 640px) {
    .featured {
      padding-block: var(--space-8);
    }

    .featured__head {
      margin-bottom: var(--space-8);
    }

    .featured__title {
      font-size: var(--font-size-6);
    }

    .featured-track {
      gap: var(--space-5);
    }

    .featured-track .hcard {
      width: 280px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Handpicked bikes and gear, ready to ride." }
  ],
  "presets": [
    { "name": "Featured Products" }
  ]
}
{% endschema %}
