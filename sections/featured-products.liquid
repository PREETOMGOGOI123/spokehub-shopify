<section class="featured reveal">
  <div class="featured-inner">
    <div class="products__head">
      <div class="products__head-left">
        <h2 class="products__title">{{ section.settings.heading }}</h2>
        <p class="products__subtitle">{{ section.settings.subheading }}</p>
      </div>
      <a href="/collections/all" class="products__viewall" id="featured-viewmore">
        <span class="products__viewall-text">View more</span>
        <span class="products__viewall-spinner" aria-hidden="true"></span>
      </a>
    </div>

    <div class="featured-slider">
      <button class="slider-arrow slider-arrow--left" aria-label="Scroll left" data-dir="-1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="featured-track" id="featured-track">
        {% assign cats = 'mtb-spares, helmets, bike-chain, road-bikes' | split: ', ' %}
        {% for handle in cats %}
          {% assign col = collections[handle] %}
          {% assign shown = 0 %}
          {% for product in col.products %}
            {% if product.available %}
              {% render 'product-card-horizontal', product: product %}
              {% assign shown = shown | plus: 1 %}
              {% if shown >= 3 %}{% break %}{% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>

      <button class="slider-arrow slider-arrow--right" aria-label="Scroll right" data-dir="1">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    var slider = document.querySelector('.featured-slider');
    if (!slider) return;
    var track = slider.querySelector('.featured-track');
    slider.querySelectorAll('.slider-arrow').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dir = parseInt(btn.getAttribute('data-dir'), 10);
        track.scrollBy({ left: dir * track.clientWidth * 0.7, behavior: 'smooth' });
      });
    });

    var viewMore = document.getElementById('featured-viewmore');
    if (viewMore) {
      viewMore.addEventListener('click', function () {
        viewMore.classList.add('is-loading');
      });
    }
  })();
</script>

{% stylesheet %}
  .featured .products__head {
    align-items: center;
  }

  .featured .products__viewall {
    position: relative;
    align-self: flex-end;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 110px;
    height: 44px;
    border: 1px solid var(--gray-12);
    color: var(--gray-12);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .featured .products__viewall::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gray-12);
    clip-path: polygon(0% 100%, 0% 100%, 0% 100%, 0% 100%);
    transition: clip-path 0.3s ease;
  }

  .featured .products__viewall:hover::before {
    clip-path: polygon(0% 100%, 100% 100%, 100% 0%, 0% 0%);
  }

  .featured .products__viewall:hover {
    border-color: transparent;
    color: #fff;
  }

  .products__viewall-text,
  .products__viewall-spinner {
    position: relative;
    z-index: 1;
  }

  .products__viewall-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid var(--gray-6, #c4c4c4);
    border-top-color: var(--gray-12);
    border-radius: 50%;
    animation: viewall-spin 0.6s linear infinite;
  }

  .products__viewall.is-loading .products__viewall-text {
    display: none;
  }

  .products__viewall.is-loading .products__viewall-spinner {
    display: block;
  }

  @keyframes viewall-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .products__head-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .products__subtitle {
    color: var(--color-muted);
    font-size: var(--font-size-3);
    max-width: 480px;
    margin: 0;
  }

  .featured {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: calc(var(--space-8) * 4) var(--page-padding) calc(var(--space-8) * 2.5);
  }

  .featured-inner {
    display: flex;
    flex-direction: column;
  }

  .featured-slider {
    position: relative;
    margin-right: calc(((100vw - var(--page-max)) / 2 + var(--page-padding)) * -1);
  }

  .featured-slider .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    margin: 0;
    transition: left 0.3s ease, right 0.3s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .featured-slider .slider-arrow--left {
    left: calc(-1 * var(--space-8) - 22px);
  }

  .featured-slider .slider-arrow--right {
    right: var(--page-padding);
  }

  .featured-slider:hover .slider-arrow--left {
    left: calc(-1 * var(--space-8) - 30px);
  }

  .featured-slider:hover .slider-arrow--right {
    right: calc(var(--page-padding) + var(--space-2));
  }

  .featured-track {
    display: flex;
    width: 100%;
    gap: var(--space-7);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }

  .featured-track::-webkit-scrollbar {
    display: none;
  }

  .featured-track .hcard {
    flex: 0 0 auto;
    width: 360px;
    scroll-snap-align: start;
  }

  .hcard {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--gray-4, #e4e4e4);
    background: #fff;
    overflow: hidden;
  }

  .hcard__img {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--gray-3);
    overflow: hidden;
  }

  .hcard__img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.06);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hcard__img:hover::after {
    opacity: 1;
  }

  .hcard__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }


  .hcard__scrim {
    display: none;
  }

  .hcard__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 2;
    background: var(--gray-12);
    color: #fff;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-medium);
    padding: var(--space-1) var(--space-2);
  }

  .hcard__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hcard__title-link {
    text-decoration: none;
    color: inherit;
  }

  .hcard__title-link:hover .hcard__title {
    color: #1a73e8;
    text-decoration: underline;
  }

  .hcard__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .hcard__actions {
    display: flex;
    gap: var(--space-2);
  }

  .hcard__icon-form {
    margin: 0;
  }

  .hcard__icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #fff;
    border: 1px solid var(--gray-12);
    color: var(--gray-12);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .hcard__icon-btn:hover {
    border-color: var(--gray-6, #c4c4c4);
  }

  .hcard__icon-btn svg {
    position: relative;
    z-index: 1;
    transition: transform 0.2s ease;
  }

  .hcard__icon-btn:hover svg {
    transform: scale(1.15);
  }

  .hcard__title {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    height: 2.6em;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hcard__price {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-bold);
    color: var(--gray-12);
    margin: 0;
  }

  @media (max-width: 900px) {
    .featured-slider {
      margin-right: 0;
    }

    .featured-slider .slider-arrow--left {
      left: var(--space-2);
    }

    .featured-slider .slider-arrow--right {
      right: var(--space-2);
    }
  }

  @media (max-width: 640px) {
    .featured-track .hcard {
      width: 280px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Handpicked bikes and gear, ready to ride." }
  ],
  "presets": [
    { "name": "Featured Products" }
  ]
}
{% endschema %}
