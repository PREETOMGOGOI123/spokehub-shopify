<div class="service-banner-wrap reveal">
  <div class="service-banner-grid">
    <section class="service-banner service-banner--main">
      <video class="service-banner__bg" autoplay muted loop playsinline preload="metadata" poster="{{ section.settings.image | default: 'service-banner.jpg' | asset_url }}" aria-hidden="true">
        <source src="https://videos.pexels.com/video-files/5446388/5446388-uhd_1440_2560_25fps.mp4" type="video/mp4">
      </video>
      <div class="service-banner__overlay"></div>
      <div class="service-banner__content">
        <p class="service-banner__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="service-banner__title">{{ section.settings.title }}</h2>
        <div class="service-banner__divider">
          <span class="service-banner__divider-line"></span>
        </div>
        <p class="service-banner__text">{{ section.settings.text }}</p>
        <a href="{{ section.settings.button_link | default: '/pages/service' }}" class="service-banner__btn">
          <span class="service-banner__btn-text">Explore</span>
        </a>
      </div>
    </section>

    <div class="service-banner__dealer">
      <img src="{{ 'shimano-dealer-banner.png' | asset_url }}" alt="Authorized Shimano Dealer">
    </div>
  </div>
</div>

{% stylesheet %}
  /* Wrapper matches .products/.services container exactly */
  .service-banner-wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: calc(var(--space-8) * 2.5) var(--page-padding) calc(var(--space-8) * 2.5);
  }

  .service-banner-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(3, 1fr);
    gap: 0;
    height: 80vh;
    width: 100%;
  }

  .service-banner {
    position: relative;
    min-height: unset;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
  }

  .service-banner--main {
    grid-row: 1 / 4;
  }

  .service-banner__dealer {
    grid-row: 1 / 4;
    overflow: hidden;
    background: var(--gray-12);
  }

  .service-banner__dealer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .service-banner__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6));
  }

  .service-banner__content {
    position: relative;
    max-width: 640px;
    margin: 0;
    padding: var(--space-8) var(--space-8) var(--space-8) var(--space-6);
    color: #fff;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-banner__eyebrow {
    color: var(--red-8);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--font-size-2);
    margin: 0 0 var(--space-3);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .service-banner__title {
    font-size: 48px;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 var(--space-4);
    max-width: 620px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  .service-banner__divider {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: var(--space-5) 0;
    width: 100%;
  }

  .service-banner__divider-line {
    flex: 1;
    height: 2px;
    background: rgba(255, 255, 255, 0.5);
  }

  .service-banner__text {
    font-size: var(--font-size-5);
    font-weight: var(--font-weight-medium);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    max-width: 520px;
    margin: 0 0 var(--space-6);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .service-banner__btn {
    position: relative;
    display: block;
    width: fit-content;
    overflow: hidden;
    background: #fff;
    color: #000;
    text-decoration: none;
    padding: var(--space-3) var(--space-7);
    border-bottom: 3px solid var(--color-accent);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-3);
  }

  .service-banner__btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    clip-path: polygon(0% 100%, 0% 100%, 0% 100%, 0% 100%);
    transition: clip-path 0.3s ease;
  }

  .service-banner__btn:hover::before {
    clip-path: polygon(0% 100%, 100% 100%, 100% 0%, 0% 0%);
  }

  .service-banner__btn-text {
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .service-banner__btn:hover .service-banner__btn-text {
    color: #fff;
  }

  @media (max-width: 900px) {
    .service-banner-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .service-banner--main {
      grid-row: auto;
    }

    .service-banner__dealer {
      grid-row: auto;
      height: 160px;
    }
  }

  @media (max-width: 640px) {
    .service-banner__title {
      font-size: var(--font-size-7);
    }

    .service-banner__text {
      font-size: var(--font-size-3);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Service Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Northeast India's Trusted Bike Workshop" },
    { "type": "text", "id": "title", "label": "Title", "default": "Expert Hands Only" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Well-trained mechanics, trusted by riders from in and out of the city." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "919038065012" },
    { "type": "text", "id": "whatsapp_message", "label": "Pre-filled message", "default": "Hi! I'd like to book a bike service." }
  ],
  "presets": [
    { "name": "Service Banner" }
  ]
}
{% endschema %}
