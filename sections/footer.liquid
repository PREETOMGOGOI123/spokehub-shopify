<footer class="footer">
  <div class="footer__inner">

    <!-- Brand -->
    <div class="footer__col footer__brand">
      <img class="footer__logo" src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name }}" width="1743" height="452">
      <p class="footer__tagline">{{ section.settings.tagline }}</p>
      <div class="footer__socials">
        {% if section.settings.whatsapp != blank %}
          <a href="https://wa.me/{{ section.settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp" class="footer__social">
            <svg width="20" height="20" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Shop links -->
    <div class="footer__col">
      <h4 class="footer__title">Shop</h4>
      <a href="/collections/bikes" class="footer__link">Bikes</a>
      <a href="/collections/apparels" class="footer__link">Apparels</a>
      <a href="/collections/helmets" class="footer__link">Helmets</a>
      <a href="/collections/all" class="footer__link">All Products</a>
    </div>

    <!-- Company links -->
    <div class="footer__col">
      <h4 class="footer__title">Company</h4>
      <a href="/pages/about" class="footer__link">About Us</a>
      <a href="/pages/contact" class="footer__link">Contact</a>
      <a href="/pages/events" class="footer__link">Events</a>
      <a href="/pages/service" class="footer__link">Service</a>
    </div>

    <!-- Contact -->
    <div class="footer__col">
      <h4 class="footer__title">Get in touch</h4>
      {% if section.settings.address != blank %}
        <p class="footer__contact">{{ section.settings.address }}</p>
      {% endif %}
      {% if section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email }}" class="footer__link">{{ section.settings.email }}</a>
      {% endif %}
      {% if section.settings.phone != blank %}
        <a href="tel:{{ section.settings.phone }}" class="footer__link">{{ section.settings.phone }}</a>
      {% endif %}
    </div>

  </div>

  <div class="footer__bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Delivering quality cycling products & reliable service since 2017." },
    { "type": "text", "id": "address", "label": "Address", "default": "VIP Road, Borbari, near Pratiksha Hospital, Guwahati, Assam 781036" },
    { "type": "text", "id": "email", "label": "Email", "default": "customersupport@spokehub.in" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 90380 65012" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (country code, no +)", "default": "919038065012" }
  ]
}
{% endschema %}
