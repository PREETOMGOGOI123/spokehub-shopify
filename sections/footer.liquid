<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__signup">
        <div class="site-footer__signup-title">{{ section.settings.signup_title }}</div>
        {%- if section.settings.signup_text != blank -%}
          <div class="site-footer__signup-text">{{ section.settings.signup_text }}</div>
        {%- endif -%}
        <form class="site-footer__form" id="footer-signup">
          <label for="footer-wa" class="visually-hidden">WhatsApp number</label>
          <input id="footer-wa" type="tel" name="wa" required placeholder="{{ section.settings.placeholder }}" class="site-footer__input">
          <button type="submit" class="site-footer__submit">{{ section.settings.button_text }}</button>
        </form>
      </div>

      <div class="site-footer__cols">
        {%- for block in section.blocks -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <div class="site-footer__col-title">{{ block.settings.title | upcase }}</div>
            {%- assign link_lines = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for line in link_lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- assign label = parts[0] | strip -%}
              {%- if label != blank -%}
                {%- assign url = parts[1] | strip -%}
                <a href="{{ url | default: '#' }}">{{ label }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</span>
      <span>{{ section.settings.payments }}</span>
    </div>
  </div>
</footer>

<script>
  (function () {
    var form = document.getElementById('footer-signup');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var number = form.querySelector('input').value.trim();
      if (!number) return;
      var text = encodeURIComponent('Hi! Please add me to ride dates and offers. My WhatsApp number: ' + number);
      window.open('https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}?text=' + text, '_blank');
    });
  })();
</script>

{% stylesheet %}
  .site-footer {
    background: var(--color-ink);
    color: #fff;
  }

  .site-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5.6rem clamp(1.6rem, 4vw, 4rem) 3.2rem;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid #333;
  }

  .site-footer__signup {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .site-footer__signup-title {
    font-family: var(--font-family-heading);
    font-weight: 800;
    font-size: 3.2rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-footer__signup-text {
    font-size: 1.5rem;
    color: #bdbdbd;
  }

  .site-footer__form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
  }

  .site-footer__input {
    flex: 1 1 200px;
    height: 48px;
    box-sizing: border-box;
    padding: 0 1.4rem;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    background: #1e1e1e;
    color: #fff;
    font: inherit;
  }

  .site-footer__input:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .site-footer__submit {
    height: 48px;
    padding: 0 2.2rem;
    border: 0;
    border-radius: 6px;
    background: var(--color-accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .site-footer__submit:hover {
    background: var(--color-accent-hover);
  }

  .site-footer__cols {
    flex: 2 1 480px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 2.4rem;
    font-size: 1.5rem;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-footer__col-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #bdbdbd;
  }

  .site-footer__col a {
    color: #fff;
    text-decoration: none;
  }

  .site-footer__col a:hover {
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.2rem;
    padding-top: 2.4rem;
    font-size: 1.3rem;
    color: #bdbdbd;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "signup_title", "label": "Sign-up heading", "default": "Get ride dates and offers first" },
    { "type": "text", "id": "signup_text", "label": "Sign-up text", "default": "One WhatsApp message a week. No spam." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your WhatsApp number" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" },
    { "type": "text", "id": "whatsapp", "label": "Shop WhatsApp number", "info": "The sign-up opens a WhatsApp chat with this number, with the visitor's number in the message.", "default": "919038065012" },
    { "type": "text", "id": "copyright", "label": "Copyright (year is added automatically)", "default": "Spokehub Cycling · Guwahati · Since 2017" },
    { "type": "text", "id": "payments", "label": "Payments line", "default": "UPI · Cards · Net banking" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "textarea", "id": "links", "label": "Links", "info": "One per line: Label | /link", "default": "Bikes | /collections/bikes\nHelmets | /collections/helmets" }
      ]
    }
  ]
}
{% endschema %}
