<section id="store" class="r-section r-section--pad">
  <div class="store">
    <div class="store__info">
      <h2 class="r-title">{{ section.settings.heading }}</h2>

      {%- if section.settings.address != blank -%}
        <div class="store__row">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
          <div>{{ section.settings.address | newline_to_br }}</div>
        </div>
      {%- endif -%}
      {%- if section.settings.hours != blank -%}
        <div class="store__row">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <div>{{ section.settings.hours }}</div>
        </div>
      {%- endif -%}
      {%- if section.settings.contact != blank -%}
        <div class="store__row">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
          <div>{{ section.settings.contact }}</div>
        </div>
      {%- endif -%}

      <div class="store__buttons">
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="r-btn r-btn--ink" target="_blank" rel="noopener">{{ section.settings.button_text }}</a>
        {%- endif -%}
        {%- if section.settings.button2_text != blank -%}
          <a href="{{ section.settings.button2_link | default: '#' }}" class="r-btn r-btn--outline" target="_blank" rel="noopener">{{ section.settings.button2_text }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.image != blank -%}
      <div class="store__map store__map--image">
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'store__img', alt: '', loading: 'lazy', sizes: '(min-width: 1280px) 650px, 100vw', widths: '600, 900, 1200' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .store {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 2.4rem;
  }

  .store__info {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .store__row {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .store__row svg {
    flex-shrink: 0;
  }

  .store__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .store__map {
    position: relative;
    flex: 1.3 1 420px;
    min-width: 0;
    min-height: 300px;
    display: flex;
    align-items: flex-end;
    box-sizing: border-box;
    padding: 1.6rem;
    overflow: hidden;
    border-radius: 10px;
    background: #e6e6e6;
    font-size: 1.3rem;
    color: #4d4d4d;
  }

  .store__map--image {
    padding: 0;
  }

  .store__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" },
    { "type": "textarea", "id": "address", "label": "Address", "info": "Leave empty for an online-only shop." },
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Chat support every day · 10:00 AM – 7:30 PM" },
    { "type": "text", "id": "contact", "label": "Phone and email", "default": "+91 70990 32144 · customersupport@spokehub.in" },
    { "type": "text", "id": "button_text", "label": "Primary button text", "default": "Chat on WhatsApp" },
    { "type": "url", "id": "button_link", "label": "Primary button link", "info": "e.g. https://wa.me/919038065012" },
    { "type": "text", "id": "button2_text", "label": "Secondary button text", "default": "Email us" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link", "info": "e.g. mailto:customersupport@spokehub.in" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Optional. Leave empty and the text uses the full width." }
  ],
  "presets": [
    { "name": "Contact" }
  ]
}
{% endschema %}
