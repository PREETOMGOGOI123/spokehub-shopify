<section class="promo reveal">
  {% assign bike_product_1 = blank %}
  {% assign bike_product_2 = blank %}
  {% assign bike_product_3 = blank %}
  {% assign bike_img_1 = blank %}
  {% assign bike_img_2 = blank %}
  {% assign bike_img_3 = blank %}
  {% assign bike_source = collections['bikes'].products %}
  {% if bike_source.size == 0 %}
    {% assign bike_source = collections.all.products %}
  {% endif %}
  {% assign found = 0 %}
  {% for product in bike_source %}
    {% if product.featured_image != blank and found < 3 %}
      {% assign found = found | plus: 1 %}
      {% if found == 1 %}{% assign bike_product_1 = product %}{% assign bike_img_1 = product.featured_image %}{% endif %}
      {% if found == 2 %}{% assign bike_product_2 = product %}{% assign bike_img_2 = product.featured_image %}{% endif %}
      {% if found == 3 %}{% assign bike_product_3 = product %}{% assign bike_img_3 = product.featured_image %}{% endif %}
    {% endif %}
    {% if found >= 3 %}{% break %}{% endif %}
  {% endfor %}

  <div class="promo__text">
    {% assign slide_count = 0 %}
    {% for i in (1..3) %}
      {% case i %}
        {% when 1 %}
          {% assign s_eyebrow = section.settings.slide_1_eyebrow %}
          {% assign s_heading_light = section.settings.slide_1_heading_light %}
          {% assign s_heading_bold = section.settings.slide_1_heading_bold %}
          {% assign s_point_1 = section.settings.slide_1_point_1 %}
          {% assign s_point_2 = section.settings.slide_1_point_2 %}
          {% assign s_point_3 = section.settings.slide_1_point_3 %}
          {% assign s_point_4 = section.settings.slide_1_point_4 %}
          {% assign s_button_text = section.settings.slide_1_button_text %}
          {% assign s_button_link = section.settings.slide_1_button_link %}
          {% assign s_image = section.settings.slide_1_image %}
          {% assign s_product = bike_product_1 %}
        {% when 2 %}
          {% assign s_eyebrow = section.settings.slide_2_eyebrow %}
          {% assign s_heading_light = section.settings.slide_2_heading_light %}
          {% assign s_heading_bold = section.settings.slide_2_heading_bold %}
          {% assign s_point_1 = section.settings.slide_2_point_1 %}
          {% assign s_point_2 = section.settings.slide_2_point_2 %}
          {% assign s_point_3 = section.settings.slide_2_point_3 %}
          {% assign s_point_4 = section.settings.slide_2_point_4 %}
          {% assign s_button_text = section.settings.slide_2_button_text %}
          {% assign s_button_link = section.settings.slide_2_button_link %}
          {% assign s_image = section.settings.slide_2_image %}
          {% assign s_product = bike_product_2 %}
        {% when 3 %}
          {% assign s_eyebrow = section.settings.slide_3_eyebrow %}
          {% assign s_heading_light = section.settings.slide_3_heading_light %}
          {% assign s_heading_bold = section.settings.slide_3_heading_bold %}
          {% assign s_point_1 = section.settings.slide_3_point_1 %}
          {% assign s_point_2 = section.settings.slide_3_point_2 %}
          {% assign s_point_3 = section.settings.slide_3_point_3 %}
          {% assign s_point_4 = section.settings.slide_3_point_4 %}
          {% assign s_button_text = section.settings.slide_3_button_text %}
          {% assign s_button_link = section.settings.slide_3_button_link %}
          {% assign s_image = section.settings.slide_3_image %}
          {% assign s_product = bike_product_3 %}
      {% endcase %}

      {% if s_heading_light != blank or s_heading_bold != blank %}
        {% assign slide_count = slide_count | plus: 1 %}
        <div class="promo__slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
          <p class="promo__eyebrow">{{ s_eyebrow }}</p>
          <h2 class="promo__heading">
            {{ s_heading_light }}
            <span class="promo__heading-bold">{{ s_heading_bold }}</span>
          </h2>
          <div class="promo__divider"></div>

          <ul class="promo__points">
            {% if s_point_1 != blank %}<li>{{ s_point_1 }}</li>{% endif %}
            {% if s_point_2 != blank %}<li>{{ s_point_2 }}</li>{% endif %}
            {% if s_point_3 != blank %}<li>{{ s_point_3 }}</li>{% endif %}
            {% if s_point_4 != blank %}<li>{{ s_point_4 }}</li>{% endif %}
          </ul>

          <div class="promo__btn-row">
            {% if s_product.selected_or_first_available_variant.id %}
              <form action="/cart/add" method="post" class="promo__btn-form">
                <input type="hidden" name="id" value="{{ s_product.selected_or_first_available_variant.id }}">
                <button type="submit" name="checkout" class="promo__btn">
                  <span class="promo__btn-text">{{ s_button_text | default: 'Buy Now' }}</span>
                </button>
              </form>
              <form action="/cart/add" method="post" class="promo__btn-form">
                <input type="hidden" name="id" value="{{ s_product.selected_or_first_available_variant.id }}">
                <button type="submit" class="promo__cart-btn" aria-label="Add {{ s_product.title }} to cart">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </button>
              </form>
            {% else %}
              <a href="{{ s_button_link | default: '/collections/bikes' }}" class="promo__btn">
                <span class="promo__btn-text">{{ s_button_text | default: 'Shop Now' }}</span>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="promo__media">
    <button class="slider-arrow promo__arrow promo__arrow--left" aria-label="Previous slide" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    {% assign bike_img_1 = blank %}
    {% assign bike_img_2 = blank %}
    {% assign bike_img_3 = blank %}
    {% assign bike_source = collections['bikes'].products %}
    {% if bike_source.size == 0 %}
      {% assign bike_source = collections.all.products %}
    {% endif %}
    {% assign found = 0 %}
    {% for product in bike_source %}
      {% if product.featured_image != blank and found < 3 %}
        {% assign found = found | plus: 1 %}
        {% if found == 1 %}{% assign bike_img_1 = product.featured_image %}{% endif %}
        {% if found == 2 %}{% assign bike_img_2 = product.featured_image %}{% endif %}
        {% if found == 3 %}{% assign bike_img_3 = product.featured_image %}{% endif %}
      {% endif %}
      {% if found >= 3 %}{% break %}{% endif %}
    {% endfor %}
    <div class="promo__imgs">
      {% assign slide_1_img = section.settings.slide_1_image | default: bike_img_1 %}
      {% if slide_1_img != blank %}
        <img src="{{ slide_1_img | image_url: width: 900 }}" alt="{{ section.settings.slide_1_heading_light }} {{ section.settings.slide_1_heading_bold }}" class="promo__img is-active" loading="lazy">
      {% endif %}

      {% assign slide_2_img = section.settings.slide_2_image | default: bike_img_2 %}
      {% if slide_2_img != blank %}
        <img src="{{ slide_2_img | image_url: width: 900 }}" alt="{{ section.settings.slide_2_heading_light }} {{ section.settings.slide_2_heading_bold }}" class="promo__img" loading="lazy">
      {% endif %}

      {% assign slide_3_img = section.settings.slide_3_image | default: bike_img_3 %}
      {% if slide_3_img != blank %}
        <img src="{{ slide_3_img | image_url: width: 900 }}" alt="{{ section.settings.slide_3_heading_light }} {{ section.settings.slide_3_heading_bold }}" class="promo__img" loading="lazy">
      {% endif %}
    </div>

    <button class="slider-arrow promo__arrow promo__arrow--right" aria-label="Next slide" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</section>

<script>
  (function () {
    var promos = document.querySelectorAll('.promo');
    promos.forEach(function (promo) {
      var imgs = promo.querySelectorAll('.promo__img');
      var slides = promo.querySelectorAll('.promo__slide');
      var count = Math.max(imgs.length, slides.length);
      if (count < 2) return;
      var index = 0;
      function show(i) {
        if (imgs[index]) imgs[index].classList.remove('is-active');
        if (slides[index]) slides[index].classList.remove('is-active');
        index = (i + count) % count;
        if (imgs[index]) imgs[index].classList.add('is-active');
        if (slides[index]) slides[index].classList.add('is-active');
      }
      var left = promo.querySelector('.promo__arrow--left');
      var right = promo.querySelector('.promo__arrow--right');
      if (left) left.addEventListener('click', function () { show(index - 1); });
      if (right) right.addEventListener('click', function () { show(index + 1); });
    });
  })();
</script>

{% stylesheet %}
  .promo {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: calc(var(--space-8) * 2.5) var(--page-padding);
    display: grid;
    grid-template-columns: 0.6fr 2fr;
    gap: var(--space-5);
    align-items: center;
  }

  .promo__text {
    position: relative;
  }

  .promo__slide {
    display: none;
  }

  .promo__slide.is-active {
    display: block;
  }

  .promo__eyebrow {
    color: var(--color-muted);
    font-size: var(--font-size-4);
    margin: 0;
  }

  .promo__heading {
    font-size: var(--font-size-8);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
    color: var(--gray-12);
    text-transform: uppercase;
    margin: var(--space-1) 0 0;
  }

  .promo__heading-bold {
    display: block;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
  }

  .promo__divider {
    width: 72px;
    height: 3px;
    background: var(--gray-12);
    margin: var(--space-5) 0;
  }

  .promo__points {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .promo__points li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--font-size-3);
    color: var(--color-text);
  }

  .promo__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4em;
    width: 12px;
    height: 12px;
    border: 1px solid var(--gray-12);
  }

  .promo__btn-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
  }

  .promo__btn-form {
    margin: 0;
  }

  .promo__btn {
    position: relative;
    display: block;
    width: fit-content;
    overflow: hidden;
    background: var(--gray-12);
    border: none;
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    padding: var(--space-3) var(--space-7);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .promo__cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 100%;
    background: #fff;
    border: 1px solid var(--gray-12);
    color: var(--gray-12);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .promo__cart-btn:hover {
    border-color: var(--gray-6, #c4c4c4);
  }

  .promo__cart-btn svg {
    transition: transform 0.2s ease;
  }

  .promo__cart-btn:hover svg {
    transform: scale(1.15);
  }

  .promo__btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    clip-path: polygon(0% 100%, 0% 100%, 0% 100%, 0% 100%);
    transition: clip-path 0.3s ease;
  }

  .promo__btn:hover::before {
    clip-path: polygon(0% 100%, 100% 100%, 100% 0%, 0% 0%);
  }

  .promo__btn-text {
    position: relative;
    z-index: 1;
  }

  .promo__media {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .promo__imgs {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 600px;
  }

  .promo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .promo__img.is-active {
    opacity: 1;
  }

  .promo__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .promo__arrow--left {
    left: var(--space-4);
  }

  .promo__arrow--right {
    right: var(--space-4);
  }

  @media (max-width: 900px) {
    .promo {
      grid-template-columns: 1fr;
    }

    .promo__media {
      order: -1;
    }
  }
{% endstylesheet %}

