<section{% if section.settings.card_style == 'bike' %} id="bikes"{% endif %} class="r-section{% if section.settings.card_style == 'bike' %} r-section--pad{% endif %}">
  <div class="r-head">
    <div>
      <h2 class="r-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="r-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.link_text != blank -%}
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="r-link">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </div>

  <div class="r-grid pgrid pgrid--{{ section.settings.card_style }}">
    {%- assign shown = 0 -%}
    {%- for product in section.settings.collection.products -%}
      {%- if section.settings.photos_only and product.featured_image == blank -%}{%- continue -%}{%- endif -%}
      {% render 'r-product-card', product: product, variant: section.settings.card_style %}
      {%- assign shown = shown | plus: 1 -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
    {%- else -%}
      <div class="pgrid__empty">Choose a collection in the theme editor to show products here.</div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .pgrid--bike {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .pgrid--gear {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .pgrid__empty {
    grid-column: 1 / -1;
    padding: 2.4rem;
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bikes in the shop" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Assembled, tuned and test-ridden before they leave." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "photos_only", "label": "Only show products that have a photo", "default": true },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "bike", "label": "Bike (wide photo, spec line)" },
        { "value": "gear", "label": "Gear (square photo, note line)" }
      ],
      "default": "bike"
    },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all bikes" }
  ],
  "presets": [
    { "name": "Product grid" }
  ]
}
{% endschema %}
