<div class="product">
  <!-- Gallery -->
  <div class="product__gallery">
    <div class="product__main-img">
      {% if product.featured_image %}
        <img id="product-main-img" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <div class="product__thumbs">
        {% for image in product.images %}
          <button class="product__thumb" data-full="{{ image | image_url: width: 800 }}">
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title }}">
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- Info -->
  <div class="product__info">
    <p class="product__vendor">{{ product.vendor }}</p>
    <h1 class="product__title">{{ product.title }}</h1>
    <p class="product__price" id="product-price">{{ product.price | money }}</p>

    {% if product.available %}
      <p class="product__stock product__stock--in">In stock</p>
    {% else %}
      <p class="product__stock product__stock--out">Sold out</p>
    {% endif %}

    {% form 'product', product %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="product__option">
            <label class="product__option-label">{{ option.name }}</label>
            <div class="product__option-values">
              {% for value in option.values %}
                <label class="product__swatch">
                  <input type="radio"
                    name="options[{{ option.name }}]"
                    value="{{ value }}"
                    {% if option.selected_value == value %}checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}

      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      <button type="submit" name="add" class="product__add"
        {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to cart{% else %}Sold out{% endif %}
      </button>
    {% endform %}

    {% if product.description != blank %}
      <div class="product__desc">{{ product.description }}</div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    // Thumbnail → main image swap
    var main = document.getElementById('product-main-img');
    document.querySelectorAll('.product__thumb').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (main) main.src = thumb.getAttribute('data-full');
        document.querySelectorAll('.product__thumb').forEach(function (t) {
          t.classList.remove('product__thumb--active');
        });
        thumb.classList.add('product__thumb--active');
      });
    });
  })();
</script>

{% stylesheet %}
  .product {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--section-y) var(--page-padding);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* Gallery */
  .product__main-img {
    aspect-ratio: 1 / 1;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .product__main-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-5);
    box-sizing: border-box;
  }

  .product__thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .product__thumb {
    width: 72px;
    height: 72px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-3);
    overflow: hidden;
    background: #fff;
    cursor: pointer;
    padding: var(--space-1);
  }

  .product__thumb--active {
    border-color: var(--color-accent);
    border-width: 2px;
  }

  .product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Info */
  .product__vendor {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--font-size-2);
    margin: 0 0 var(--space-2);
  }

  .product__title {
    font-size: var(--font-size-8);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }

  .product__price {
    font-size: var(--font-size-6);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }

  .product__stock {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-medium);
    margin: 0 0 var(--space-5);
  }

  .product__stock--in {
    color: #2e7d32;
  }

  .product__stock--out {
    color: var(--color-muted);
  }

  .product__option {
    margin-bottom: var(--space-5);
  }

  .product__option-label {
    display: block;
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-2);
    margin-bottom: var(--space-3);
  }

  .product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product__swatch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .product__swatch span {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2);
    cursor: pointer;
    font-size: var(--font-size-2);
    transition: all 0.15s;
  }

  .product__swatch input:checked+span {
    border-color: var(--color-accent);
    background: var(--red-2);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
  }

  .product__add {
    width: 100%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    padding: var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    margin: var(--space-4) 0 var(--space-6);
    transition: background 0.2s;
  }

  .product__add:hover:not(:disabled) {
    background: var(--color-accent-hover);
  }

  .product__add:disabled {
    background: var(--gray-8);
    cursor: not-allowed;
  }

  .product__desc {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
    line-height: 1.6;
    color: var(--gray-11);
  }

  @media (max-width: 800px) {
    .product {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .product__title {
      font-size: var(--font-size-7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
