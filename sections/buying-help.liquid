<section id="help" class="r-section">
  <div class="help">
    <div class="help__copy">
      {%- if section.settings.eyebrow != blank -%}
        <div class="r-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="help__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="help__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="help__buttons">
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="r-btn r-btn--ink" target="_blank" rel="noopener">{{ section.settings.button_text }}</a>
        {%- endif -%}
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link | default: routes.root_url }}" class="r-link help__all">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>
      <div class="help__photo{% if section.settings.image != blank %} help__photo--image{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: class: 'help__img', alt: '', loading: 'lazy', sizes: '(min-width: 1280px) 450px, 100vw', widths: '450, 700, 900' }}
        {%- else -%}
          PHOTO · rider unboxing a Spokehub delivery
        {%- endif -%}
      </div>
    </div>

    <div class="help__list">
      {%- assign card_no = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign card_no = card_no | plus: 1 -%}
        <a href="{{ block.settings.link | default: routes.root_url }}" class="help-card" {{ block.shopify_attributes }}>
          <div class="help-card__no">{% if card_no < 10 %}0{% endif %}{{ card_no }}</div>
          <div class="help-card__info">
            <div class="help-card__tag">{{ block.settings.tag }}</div>
            <div class="help-card__name">{{ block.settings.name }}</div>
            <div class="help-card__text">{{ block.settings.text }}</div>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .help {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    padding: clamp(2.4rem, 4vw, 4.8rem);
    border-radius: 14px;
    background: var(--color-surface);
  }

  .help__copy {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .help__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 800;
    font-size: clamp(3.6rem, 4.5vw, 5.6rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .help__text {
    margin: 0;
    color: #3d3d3d;
  }

  .help__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .help__all {
    display: inline-flex;
    align-items: center;
    height: 4.8rem;
  }

  .help__photo {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 160px;
    box-sizing: border-box;
    padding: 1.4rem;
    overflow: hidden;
    border-radius: 10px;
    background: #e6e6e6;
    font-size: 1.3rem;
    color: #4d4d4d;
  }

  .help__photo--image {
    min-height: 220px;
    padding: 0;
  }

  .help__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .help__list {
    flex: 1.4 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .help-card {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    padding: 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .help-card:hover {
    border-color: var(--color-ink);
  }

  .help-card__no {
    flex: 0 0 72px;
    width: 72px;
    padding: 1.4rem 0;
    border-radius: 8px;
    background: var(--color-bg);
    text-align: center;
    font-family: var(--font-family-heading);
    font-weight: 800;
    font-size: 3.2rem;
    line-height: 1;
  }

  .help-card__info {
    flex: 1;
    min-width: 0;
  }

  .help-card__tag {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .help-card__name {
    font-size: 1.8rem;
    font-weight: 700;
  }

  .help-card__text {
    font-size: 1.4rem;
    color: #5c5c5c;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Buying help",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ONLINE SHOP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what to buy?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell us how and where you ride. A real rider will help you pick the right bike, size and parts — before you pay." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Ask on WhatsApp" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "e.g. https://wa.me/919038065012" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "All guides" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "For example a rider with a Spokehub delivery." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Guide card",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "SIZE GUIDE" },
        { "type": "text", "id": "name", "label": "Title", "default": "Find your bike size" },
        { "type": "text", "id": "text", "label": "Description", "default": "Height and inseam chart for every frame size" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Buying help" }
  ]
}
{% endschema %}
